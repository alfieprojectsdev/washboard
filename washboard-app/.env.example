# Copy to .env.local for local development. In production, set these in
# Vercel -> Project -> Settings -> Environment Variables. Never commit real values.

# Neon connection string. Use the pooled host (…-pooler…) and keep sslmode=require.
DATABASE_URL=postgresql://user:password@your-project-pooler.region.aws.neon.tech/neondb?sslmode=require

# Canonical site URL. Magic links and QR codes are built from this.
NEXT_PUBLIC_APP_URL=https://washboard.example.com

# Receptionist signup is invite-only. Set a code, share it with the new
# receptionist, then change or delete it. Unset = signup closed.
SIGNUP_INVITE_CODE=

# Optional: Discord channel webhook that gets a message for each feedback
# submission (Server Settings -> Integrations -> Webhooks -> New Webhook).
# Feedback is always saved to the feedback table either way.
FEEDBACK_WEBHOOK_URL=

# Optional: GoatCounter site code (https://<code>.goatcounter.com)
NEXT_PUBLIC_GOATCOUNTER_CODE=
